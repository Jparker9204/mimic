# /etc/mimic.env  (chmod 600, owned by root). Set the token with: sudo mimic-set-token
MIMIC_BOT_TOKEN=
# Optional but recommended: a private Solana RPC URL (e.g. a free Helius/QuickNode key).
# MIMIC_RPC_URL=
# Optional: Telegram user IDs (comma separated) that use the bot for free with no cooldown and can run
# /grant, /ledger and /orders (find your ID under "💳 Credits").
# MIMIC_ADMIN_IDS=
# Optional credits settings (defaults shown). Apply changes with: sudo systemctl restart mimic-bot
# MIMIC_COST_COIN=10
# MIMIC_COST_WALLET=3
# MIMIC_COST_SIM=15
# MIMIC_FREE_REFILL=40
# MIMIC_REFILL_HOURS=6
# MIMIC_FREE_CAP=150
# Buying credits with SOL (Solana Pay). MIMIC_PAY_ADDRESS is the PUBLIC address that receives payments
# (a dedicated wallet is best). Never put a private key or seed phrase here: Mimic only watches the address.
# Without it, the Buy button says payments aren't available yet.
# MIMIC_PAY_ADDRESS=
# MIMIC_PRICE_PER_CREDIT_SOL=0.001
# MIMIC_MIN_PURCHASE_SOL=0.02
# MIMIC_MAX_PURCHASE_SOL=5
# MIMIC_BUY_AMOUNTS=0.02,0.05,0.1,0.25
# MIMIC_ORDER_MINUTES=15
# MIMIC_LATE_PAYMENT_HOURS=24
# Optional tuning (defaults shown)
# MIMIC_COOLDOWN_S=25
# MIMIC_MAX_JOBS=2
# MIMIC_MAX_TXS=800
# MIMIC_TX_BUDGET_S=100
# MIMIC_CACHE_TTL_MIN=45
