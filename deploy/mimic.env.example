# /etc/mimic.env  (chmod 600, owned by root). Set the token with: sudo mimic-set-token
MIMIC_BOT_TOKEN=
# Optional but recommended: a private Solana RPC URL (e.g. a free Helius/QuickNode key).
# MIMIC_RPC_URL=
# Optional: Telegram user IDs (comma separated) that skip free limits (find yours under "My Limits").
# MIMIC_ADMIN_IDS=
# Optional tuning (defaults shown)
# MIMIC_FREE_WALLET=5
# MIMIC_FREE_COIN=3
# MIMIC_FREE_SIM=2
# MIMIC_COOLDOWN_S=25
# MIMIC_MAX_JOBS=2
# MIMIC_MAX_TXS=800
# MIMIC_TX_BUDGET_S=100
# MIMIC_CACHE_TTL_MIN=45
